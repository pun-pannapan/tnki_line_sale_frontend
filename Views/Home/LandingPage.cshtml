@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var jsonData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
}

<div class="main-body">
    @* original content showing how to submit receipt *@
    <div class="p-2">
        <div class="profile-box mt-4 profile-point" style="margin-bottom: 80px; padding: 0px !important;">
            <h2 style="background: linear-gradient(90deg, #ffc000 20%, #f3e6bf 58%, #f5cf5d 63%, #ffc000 79%); border-radius: 10px 10px 0px 0px; color: #02539c; font-size: 32px; text-align: center; padding: 30px; font-family: 'Kittithada Bold'; ">คำแนะนำในการส่งใบเสร็จ</h2>           
            <div class="text" align="left" style="padding: 10px 15px;">
                เพื่อความสะดวกในการตรวจสอบใบเสร็จ กรุณาถ่ายรูป/บันทึกภาพหน้าจอให้เห็นทั้งใบเสร็จ <font style="text-decoration: underline; ">โดยให้เห็นรายการสินค้า จำนวนสินค้า และเลขที่ใบเสร็จชัดเจน</font>
                <p style="color: red;">
                    สำหรับกิจกรรม Top Spender ผู้เข้าร่วมต้องเก็บใบเสร็จรับเงิน/ใบกำกับภาษีตัวจริงไว้ทุกครั้ง เพื่อใช้เป็นหลักฐานในการเข้าร่วมงานหากชนะกิจกรรม
                </p>
                <h4 class="font-bold">
                    1. ตัวอย่างใบเสร็จสินค้าช่องทางเซเว่นอีเลฟเว่น
                </h4>
                <ul>
                    <li>ถ่ายรูปให้เห็นทั้งใบเสร็จ</li>
                    <li>บันทึกภาพหน้าจอ (Capture) จากเมนูใบเสร็จ ในแอปฯ 7-Eleven สำหรับช่องทาง 7-Delevery </li>
                    <li>
                        บันทึกภาพหน้าจอ (Capture จากประวัติการสั่งซื้อ > ดูรายละเอียด > กดดาวน์โหลดใบเสร็จรับเงิน/ใบกำกับภาษีอิเล็กทรอนิกส์อย่างอย่างย่อ (pdf) สำหรับช่องทาง ALL Online
                    </li>
                </ul>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_711.png?v=101" />
                    <img class="w-100 mt-2" src="~/assets/img/SampleRec/Rec_711Delivery.png?v=101" />
                    <img class="w-100 mt-2" src="~/assets/img/SampleRec/Rec_711AllOnline.png?v=101" />
                </div>
                <h4 class="font-bold mt-4">
                    2. ตัวอย่างใบเสร็จสินค้า ช่องทาง Big C
                </h4>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_BigC.png?v=1002" />
                </div>
                <h4 class="font-bold mt-4">
                    3. ตัวอย่างใบเสร็จสินค้า ช่องทาง Lotus’s
                </h4>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_Lotus.png?v=1002" />
                </div>

                <h4 class="font-bold mt-4">
                    4. ตัวอย่างใบเสร็จสินค้า ช่องทาง Makro
                </h4>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_Makro.png?v=1002" />
                </div>

                <h4 class="font-bold mt-4">
                    5. ตัวอย่างใบเสร็จสินค้า ช่องทาง Lazada
                </h4>
                <ul>
                    <li style="color: red;">
                        บัญชี > รายการสั่งซื้อทั้งหมด > รายละเอียดคำสั่งซื้อ > บันทึกภาพหน้าจอ (Capture)
                    </li>
                </ul>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_Lazada.png?v=1002" />
                </div>
                <div align="center">
                    <h4 class="font-bold mt-4">
                        วีธีแสดงหลักฐานช่องทาง Lazada
                    </h4>
                </div>
                <ul>
                    <li style="color: red;">
                        สำหรับใบเสร็จ ลูกค้าจะต้องทักแชทแอดมินในแอพ Lazada เพื่อขอด้วยตนเองเท่านั้น ให้ปริ้นและเก็บใบเสร็จที่จะได้ไว้เป็นหลักฐานในการยืนยัน ทุกครั้ง
                    </li>
                    <li>
                        กรอกฟอร์มในลิ้งค์ <a style="text-decoration: underline;" href="https://docs.google.com/forms/d/e/1FAIpQLSfDWqt23GH93PUHf2SAVsgQ3Ht5NYRmyj3WSqhv2CitHROgtw/viewform" target="_blank">แบบฟอร์มขอใบรับเงิน</a> หรือทักแชทในแอพ Lazada ร้าน Unilever Home

                    </li>
                    <li>ใบเสร็จจะถูกส่งเข้าไปในอีเมลที่กรอกในฟอร์มภายใน 3-5 วันทำการ</li>
                    <li>ปริ้นใบเสร็จเพื่อนำไปแสดงเพื่อรับรางวัลที่หน้างาน</li>
                </ul>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_Lazada02.png" />
                </div>

                <h4 class="font-bold mt-4">
                    6. ตัวอย่างใบเสร็จสินค้า ช่องทาง Shopee
                </h4>
                <ul>
                    <li>ฉัน > การซื้อของฉัน > รายละเอียดคำสั่งซื้อ > บันทึกภาพหน้าจอ (Capture)</li>
                    <li style="color: red;">
                        ใบกำกับภาษีแบบเต็มรูปแบบจะถูกส่งไปพร้อมกับสินค้า ให้เก็บใบกับกับภาษีที่แนบไปกับพัสดุ ไว้เป็นหลักฐานในการยืนยันทุกครั้ง
                    </li>
                </ul>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_Shopee.png?v=1002" />
                </div>
                <div align="center">
                    <h4 class="font-bold mt-4">
                        วีธีแสดงหลักฐานช่องทาง Shopee
                    </h4>
                </div>
                <ul>
                    <li style="color: red;">
                        ใบเสร็จจะอยู่ในกล่องที่ส่งไปถึงลูกค้า
                    </li>
                    <li>
                        นำใบเสร็จที่แนบมาโชว์ตอนได้รับรางวัล
                    </li>
                </ul>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_Shopee02.png?v=1002" />
                </div>
                <div align="center">
                    <h3 class="font-bold mt-4" style="text-decoration: underline;">
                        ใบเสร็จ/บิลเงินสด ที่เขียนด้วยลายมือทุกชนิด ไม่สามารถใช้ในการร่วมกิจกรรมได้
                    </h3>
                </div>
                <div class="text-center">
                    <img class="w-100" src="~/assets/img/SampleRec/Rec_Bill.png?v=1003" />
                </div>
            </div>
            <div class="m-3">
                <button class="btn btn-primary btn-animate w-100" data-bind="click: myObject.gotoSendRec"> <span>เริ่มส่งใบเสร็จ​</span></button>
            </div>
        </div>
    </div>

