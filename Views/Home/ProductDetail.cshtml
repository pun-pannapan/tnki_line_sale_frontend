@model tnki_line_sale_frontend.Models.ProductDataModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <style>
        .promo-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: .9rem;
            padding: .4rem .6rem;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .shop-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #eee;
        }
        .qty-control {
            gap: 10px;
        }
        .btn-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid #ccc;
            background-color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            line-height: 1;
            cursor: pointer;
            padding: 0;
        }
        .btn-circle:hover {
            background-color: #f2f2f2;
        }
        #qty-display {
            min-width: 24px;
            text-align: center;
            font-weight: 500;
            font-size: 16px;
        }
        strong{
            font-weight:bold;
        }
        ul {
            margin-bottom:0px;
        }
    </style>
}

<div class="">
    <div class="card shadow-sm border-0">
        <div class="position-relative">
            <!-- รูปสินค้า -->
            <img class="img-fluid w-100 d-block"
                 data-bind="attr: { src: myObject.prodImage, alt: myObject.prodName }" />
            <!-- ป้ายจำนวนแพ็ค (ถ้ามี) -->
            <div class="badge badge-primary promo-badge"
                 data-bind="text: myObject.prodPackSize, visible: myObject.prodPackSize"></div>
        </div>

        <div class="card-body">
            <!-- Remark -->
            <div class="text-primary small mb-1"
                 data-bind="text: myObject.prodRemark, visible: myObject.prodRemark"></div>

            <!-- ชื่อสินค้า -->
            <h5 class="mb-2 line-clamp-2" data-bind="text: myObject.prodName"></h5>

            <!-- ราคา -->
            <div class="d-flex align-items-end mb-2">
                <div class="h4 mb-0 mr-2 font-weight-bold" data-bind="text: formattedPrice"></div>
            </div>

            <!-- Quantity -->
            <div class="mb-3">
                <div class="d-flex align-items-center">
                    <label class="mb-0 font-weight-bold mr-3">Quantity</label>
                    <div class="d-flex align-items-center qty-control">
                        <button type="button" class="btn-circle" data-bind="click: decQty">−</button>
                        <span id="qty-display" data-bind="text: qty">1</span>
                        <button type="button" class="btn-circle" data-bind="click: incQty">+</button>
                    </div>
                </div>
            </div>

            <!-- รายละเอียดสินค้า (HTML) -->
            <div data-bind="visible: myObject.prodDesc">
                <span class="px-3 py-2" data-bind="html: myObject.prodDesc"></span>
            </div>

            <!-- ปุ่ม -->
            <div class="d-flex mb-5">
                <button type="button"
                        class="btn btn-dark btn-lg flex-fill mr-2 mb-5"
                        data-bind="click: buyNow">
                    Buy Now
                </button>
                <button type="button"
                        class="btn btn-light btn-lg flex-fill mb-5"
                        data-bind="click: addToCart">
                    Add to cart
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
                $(function () {
            var mapping = {}

            function ViewModel(data) {
                var self = this; // แก้ไข: ใช้ var self = this แทน self.myObject = this
                self.myObject = {};

                self.qty = ko.observable(1);
                self.incQty = function(){ self.qty(self.qty() + 1); };
                self.decQty = function(){ if (self.qty() > 1) self.qty(self.qty() - 1); };

                self.formattedPrice = ko.pureComputed(function () {
                    var p = Number(self.myObject.prodPrice() || 0);
                    return '฿' + p.toLocaleString('th-TH');
                });

                ko.mapping.fromJS(data, {}, self.myObject);

                self.addToCart = function () {
                    var productId = self.myObject.prodGuid();
                    var qty = self.qty();
                    fetch('/Home/AddToCart', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        body: JSON.stringify({ productId: productId, qty: qty })
                    }).then(function (res) {
                        if (res.ok) toastr.info("✔️ เพิ่มแล้วในตะกร้า");
                        else toastr.info("ไม่สามารถเพิ่มสินค้าได้ กรุณาลองอีกครั้ง");
                    });
                };

                self.buyNow = function () {
                    var productCode = @ViewBag.ProductCode
                    window.location.href = '/Home/BuyNow/' + productCode ;
                };

                self.loadProduct = function () {
                    var code =  @ViewBag.ProductCode
                    if (!code) return;
                    blockUI();
                    getProductByProdCode(code, function (result) {
                        try {
                            var data = result && (result.data || result);
                            console.log("Data :", data);
                            ko.mapping.fromJS(data, {}, self.myObject);
                        } finally {
                            $.unblockUI();
                        }
                    });
                };

                // เรียกใช้ loadProduct ตอนสร้าง ViewModel
                self.loadProduct();
            }

            var model = JSON.parse('@Html.Raw(Json.Serialize(Model))');
            console.log(model);
            var vm = new ViewModel(model)
            ko.applyBindings(vm);
            reauthenLiff('home/ProductDetail', '', 'PRODUCTDETAIL');
            // vm.loadProduct();
        });
    </script>
}