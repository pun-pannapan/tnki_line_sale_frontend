@model tnki_line_sale_frontend.Models.ProductDataModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var jsonData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
}
@section Styles {
    <style>
        .promo-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: .9rem;
            padding: .4rem .6rem;
        }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .shop-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #eee;
        }

        .qty-control {
            gap: 10px;
        }

        .btn-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid #ccc;
            background-color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            line-height: 1;
            cursor: pointer;
            padding: 0;
        }

        .btn-circle:hover {
            background-color: #f2f2f2;
        }

        #qty-display {
            min-width: 24px;
            text-align: center;
            font-weight: 500;
            font-size: 16px;
        }

        strong{
            font-weight:bold;
        }

        ul {
            margin-bottom:0px;
        }
    </style>
}

<div class="">
    <div class="card shadow-sm border-0">
        <div class="position-relative">
            <img src="@Url.Content(Model.prodImage)" class="img-fluid w-100 d-block" alt="@Model.prodName" />                     
        </div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.prodRemark))
            {
                <div class="text-primary small mb-1">@Model.prodRemark</div>
            }

            <h5 class="mb-2 line-clamp-2">@Model.prodName</h5>

            <div class="d-flex align-items-end mb-2">
                <div class="h4 mb-0 mr-2 font-weight-bold">฿@Model.prodPrice.ToString("N0")</div>
            </div>

            <div class="mb-3">
                <div class="d-flex align-items-center">
                    <label class="mb-0 font-weight-bold mr-3">
                        Quantity
                    </label>
                    <div class="d-flex align-items-center qty-control">
                        <button type="button" class="btn-circle" id="qty-minus">−</button>
                        <span id="qty-display">1</span>
                        <button type="button" class="btn-circle" id="qty-plus">+</button>
                    </div>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.prodDesc))
            {
                <div class="">
                    <span class="px-3 py-2">@Html.Raw(Model.prodDesc)</span>
                </div>
            }

            <div class="d-flex mb-5">
                <button type="button" class="btn btn-dark btn-lg flex-fill mr-2 mb-5" id="btn-buy-now" onclick="buyNow(@ViewBag.ProductId)"
                        data-id="@Model.prodGuid" data-code="@Model.prodCode">
                    Buy Now
                </button>
                <button type="button" class="btn btn-light btn-lg flex-fill mb-5" id="btn-add-to-cart" onclick="addToCart(@ViewBag.ProductId)"
                        data-id="@Model.prodGuid" data-code="@Model.prodCode">
                    Add to cart
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        function addToCart(productId) {
            fetch('/Home/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ productId: productId })
            })
            .then(response => {
                if (response.ok) {
                     toastr.info("✔️ เพิ่มแล้วในตะกร้า");
                } else {
                    toastr.info("ไม่สามารถเพิ่มสินค้าได้ กรุณาลองอีกครั้ง");
                }
            });
        }

        function buyNow(productId) {
            window.location.href = '/Home/BuyNow/' + productId;
        }

        $(function () {
            let qty = 1;
            const qtyDisplay = document.getElementById("qty-display");
            const btnMinus = document.getElementById("qty-minus");
            const btnPlus = document.getElementById("qty-plus");

            btnMinus.addEventListener("click", function(){
                if (qty > 1) qty--;
                qtyDisplay.textContent = qty;
            });

            btnPlus.addEventListener("click", function(){
                qty++;
                qtyDisplay.textContent = qty;
            });

             $(document).ready(function () {

                reauthenLiff('home/ProductDetail', '', 'PRODUCTDETAIL');
            });
           
          });
    </script>
}