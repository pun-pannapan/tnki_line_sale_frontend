@model tnki_line_sale_frontend.Models.CustProfileModel
@{
    Layout = "~/Views/Shared/_LayoutEmpty.cshtml";
}
<div class="wrapper body-shadow main-body">
    <div class="p-2">
        <div class="text-center">
            <img class="img-fluid" src="~/assets/img/logo.png" alt="" width="150">
        </div>
        <div  data-bind='validationOptions: { insertMessages: false }'>
            <div class="profile-box  profile-point" style="padding: 0px 10px 10px 10px; margin: 20px 0px;">
                <div class="form-item">
                    <div class="text-center">
                        <h2 class="text-secondary mb-0"><strong>ลงทะเบียน</strong></h2>
                    </div>
                    <div class="icon-wrapper">
                        <input class="form-control icon-name icon" type="text" pattern="[A-Za-zก-ฮ]{1,}" placeholder="ชื่อ" data-bind="value: myObject.custData.custFirstName">
                        <span class="validationMessage text-danger small" data-bind="validationMessage:  myObject.custData.custFirstName"></span>
                    </div>
                    <div class="icon-wrapper mt-2">
                        <input class="form-control icon-name icon" type="text" pattern="[A-Za-zก-ฮ]{1,}" placeholder="นามสกุล" data-bind="value: myObject.custData.custLastName">
                        <span class="validationMessage text-danger small" data-bind="validationMessage:  myObject.custData.custLastName"></span>
                    </div>
                    <div class="icon-wrapper mt-2">
                        <input class="form-control icon-phone icon numeric"
                               oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);"
                               pattern="[0-9]*" inputmode="numeric" maxlength="10" type="number" placeholder="เบอร์โทรศัพท์มือถือ​" data-bind="value: myObject.custData.custTel">
                        <span class="validationMessage text-danger small" data-bind="validationMessage:  myObject.custData.custTel"></span>
                    </div>
                </div>
                <div class="mt-3">
                    <div style="padding-left: 1rem;" class="custom-control custom-checkbox ">
                        <input type="checkbox" class="custom-control-input" id="isCheckTerm1" data-bind="checked: myObject.custData.custCheckPrivacy">
                        <label class="custom-control-label lableregister" for="isCheckTerm1">
                            ข้าพเจ้าได้อ่านข้อความในเอกสารฉบับนี้  <a class="aregister" data-bind="click:  myObject.showTerm">ข้อตกลงและเงื่อนไขการให้บริการ</a> โดยครบถ้วนแล้ว และยินยอมให้บริษัทฯ เก็บรวบรวม ใช้ ประมวลผล และเปิดเผยข้อมูลส่วนบุคคลดังที่กำหนดในเอกสารนี้
                           
                        </label>
                    </div>
                    <div style="padding-left: 1rem;" class="custom-control custom-checkbox ">
                        <input type="checkbox" class="custom-control-input" id="isCheckTerm2" data-bind="checked: myObject.custData.custCheckTerm">
                        <label class="custom-control-label lableregister" for="isCheckTerm2">
                            ยินยอมรับข้อมูลข่าวสาร การนำเสนอเกี่ยวกับผลิตภัณฑ์ การให้บริการหรือสิทธิประโยชน์ต่างๆ ของผลิตภัณฑ์บริษัท บริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด ที่น่าสนใจได้
                        </label>

                    </div>

                </div>
            </div>
            <div class="mt-3" align="center">
                <button class="btn btn-primary btn-animate w-75" data-bind="enable: myObject.isAccept, click: myObject.insertPersonalData"> <span>ยืนยัน</span></button>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-popup popup-profile-cancel" tabindex="-1" role="dialog" id="popupTerm" align="center">
    <div class="modal-dialog modal-dialog-centered" role="document" style="margin: 0px !important;">
      @*   <div class="modal-content">
            <div class="modal-body">
                <h2>เงื่อนไขและข้อตกลงการใช้บริการ<br />บริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด</h2>
                <div class="text" align="left">
                    <p>บริษัท ยูนิลีเวอร์ ไทย เทรดดิ้ง จํากัด (“บริษัท”) มีจุดประสงค์แจ้งเงื่อนไขและข้อตกลงการใช้บริการ ในการเข้าร่วมและ/หรือใช้บริการ บริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด ของบริษัทผ่านบัญชี LINE Official “Ranger Order Online” (Line@@: @@ranger.online) แพลตฟอร์ม บริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด  (“บริการ”) เพื่อให้ผู้เข้าร่วมกิจกรรมและ/หรือใช้บริการ (“ผู้ใช้บริการ”) ทราบถึง เงื่อนไข สิทธิและหน้าที่ของบริษัทและผู้ใช้บริการในการใช้และเข้าถึงบริการ</p>
                <p style="font-weight: bold;">ขอบเขตการบังคับใช้ของเงื่อนไขและข้อตกลงการใช้บริการฉบับนี้</p>
                    <p>เงื่อนไขและข้อตกลงการใช้บริการฉบับนี้มีผลใช้บังคับกับกระบวนการให้บริการของบริษัทผ่านทาง บัญชี LINE Official “Ranger Order Online” (Line@@: @@ranger.online) ซึ่งรวมถึงการให้บริการดังนี้ แก่ผู้ใช้บริการ: </p>
                <ol>
                    <li>สะสม และแลกคะแนนสะสมจากการซื้อสินค้า และ/หรือการใช้บริการของบริษัท</li>
                    <li>การให้คำแนะนำในการใช้สินค้า และ/หรือการใช้บริการของบริษัทให้เหมาะสม โดยอ้างอิงจากใบเสร็จที่ผู้ใช้บริการได้ให้แก่บริษัท</li>
                </ol>                <p>โดยผู้ใช้บริการทั้งหมดต้องลงทะเบียนเปิดบัญชีผู้ใช้งานจึงจะสามารถใช้บริการทั้งหมดของบริษัทผ่านระบบได้ </p>
                    <p style="font-weight: bold;">เงื่อนไขการร่วมกิจกรรม แลกรับของรางวัล ซื้อแล้วแลกเลย จาก “บริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด”</p>
                <p style="font-weight: bold;">ข้อตกลงและเงื่อนไขในการร่วมกิจกรรม</p>
                <ol>
                    <li>ร่วมกิจกรรมได้ตั้งแต่วันที่ 19 เมษายน 2566 ถึง วันที่ 30 มิถุนายน 2566 หรือจนกว่าสิทธิ์จะเต็ม</li>
                        <li>ซื้อ หรือสะสมยอดซื้อ ผลิตภัณฑ์บริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด ประเภทใด ขนาดใดก็ได้ ตามช่องทางการซื้อที่กำหนด ตามยอดรวมของสินค้าที่กำหนด จาก โลตัส บิ๊กซี ท็อปส์ เซ็นทรัลฟู้ดฮอลล์ กูร์เมต์มาร์เก็ต แม็กซ์แวลู แม็คโคร เซเว่นอีเลฟเว่น ซีเจเอ็กซ์เพรส วิลล่ามาร์เกต ฟู้ดแลนด์ จิฟฟี่ ลอว์สัน และ ร้านค้า/ห้างใกล้บ้านในจังหวัดที่จดทะเบียนถูกต้องตามกฏหมายและทางบริษัทฯ ไม่รับใบเสร็จรูปแบบเขียนด้วยลายมือทุกชนิดในการพิจารณา</li>
                    <li>สามารถสะสมยอดซื้อเพื่อเลือกรับของรางวัลอย่างใดอย่างหนึ่งเท่านั้น เมื่อยอดสะสมถึงตามที่กำหนด</li>
                </ol>
                <p style="font-weight: bold;">ของรางวัล</p>
                <ul>
                        <li>ซื้อครบ 500 บาท เลือกรับ gift voucher บริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด มูลค่า 100 บาท</li>
                </ul>
                <p>เงื่อนไข :</p>
                <ul>
                        <li>การแลกรางวัลกระเป๋าบริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัดนุ่มนิ่ม เป็นสิทธิพิเศษสำหรับลูกค้าที่ซื้อสินค้าบริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด ผ่านช่องทางเซเว่นอีเลฟเว่นเท่านั้น โดยลูกค้าสามารถเลือกแลกรางวัลดังกล่าวได้ โดยจะไม่ตัดคะแนนจากคะแนนสะสมทั้งหมด</li>
                    <li>สามารถเลือกแลกของรางวัลสูงสุด 1 ชิ้นต่อประเภทของรางวัลเท่านั้น ตลอดระยะเวลากิจกรรม และสิทธิ์นี้ไม่สามารถโอนสิทธิ์ ถอน หรือแลกเปลี่ยนเป็นเงินสด หรือของรางวัลอื่นได้</li>
                </ul>
                <p style="font-weight: bold;">คุณสมบัติผู้ร่วมกิจกรรม</p>
                <ol>
                    <li>ผู้ที่สามารถเข้าร่วมกิจกรรมนี้ต้องเป็นผู้ที่ปฏิบัติตามเงื่อนไขในการร่วมกิจกรรมข้างต้น</li>
                        <li>พนักงาน และสมาชิกครอบครัวของพนักงานของบริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด รวมถึงบริษัทในเครือ และบริษัทตัวแทนโฆษณาและหรือส่งเสริมการขาย รวมทั้งบริษัทใด ๆ ที่เกี่ยวข้องไม่มีสิทธิเข้าร่วมกิจกรรมนี้ </li>
                </ol>
                <p style="font-weight: bold;">การประกาศผล วิธีการยืนยันสิทธิ์และเงื่อนไขการรับรางวัล</p>
                <ol>
                        <li>วิธีการรับสิทธิ์ เพียงถ่ายรูปใบเสร็จ มาลงทะเบียนแลกรับของรางวัลด้วยการสแกน QR CODE <a href="https://www.thanatkorn.com/">https://www.thanatkorn.com/</a> หรือ ผ่านบัญชี LINE Official “แม่บ้านมือโปร”</li>
                    <li>พร้อมกรอกข้อมูล ชื่อ นามสกุล หมายเลขโทรศัพท์ ที่อยู่เพื่อรับของรางวัล และอัพโหลดใบเสร็จ ระบบจะใช้เวลายืนยันข้อมูลภายใน 24 ชม. และจะแจ้งผลยืนยันการลงทะเบียนผ่านหน้าแชท บัญชี LINE Official “แม่บ้านมือโปร”</li>
                    <li>จำกัดของรางวัล 1 สิทธิ์/ท่าน/รางวัล โดย 1 สิทธิ์ สามารถอัพโหลดใบเสร็จได้หลายครั้ง โดยที่ใบเสร็จมีจำนวนกี่ใบก็ได้ ซื้อจากร้านค้าไหนก็ได้ และใบเสร็จที่ใช้สะสมยอดจะต้องเป็นใบเสร็จที่อยู่ภายในระยะเวลาที่กำหนดของกิจกรรมเท่านั้น</li>
                        <li>ใบเสร็จที่นำมาร่วมกิจกรรม จะนับเฉพาะยอดซื้อสินค้าบริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด (ไม่รวมสินค้าอื่น ๆ แม้จะเป็นใบเสร็จเดียวกัน) ในช่องทางการซื้อเดียวกัน โดยคิดยอดซื้อหลังหักส่วนลดบริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัดต่างๆ ท้ายใบเสร็จ และเป็นยอดรวมภาษีเท่านั้น</li>
                    <li>ใบเสร็จจะต้องเป็นใบกำกับภาษีที่มี Tax Invoice ที่ออกโดยร้านค้าหรือห้างสรรพสินค้าเท่านั้น</li>
                    <li>ผู้เข้าร่วมกิจกรรมจะทราบผลการลงทะเบียนภายใน 24 ชม.</li>
                    <li>ของรางวัลจะถูกจัดส่งผ่านไปรษณีย์ ไปยังที่อยู่ของผู้ร่วมกิจกรรมตามที่ระบุไว้ภายใน 1 สัปดาห์หลังจากได้รับยืนยันการลงทะเบียนสำเร็จ</li>
                    <li>ผู้จัดกิจกรรมจะเป็นผู้รับผิดชอบค่าขนส่งที่เกิดขึ้น หากผู้ร่วมกิจกรรมปฏิเสธการรับพัสดุ จะต้องชำระค่าขนส่งครั้งถัดไปด้วยตนเอง</li>
                        <li>ผู้ที่ได้รับรางวัลจะต้องกรอก ชื่อ-นามสกุล ตามบัตรประชาชน, เบอร์โทรศัพท์ และที่อยู่สำหรับจัดส่งรางวัลผ่านทางหน้าเว็บไซต์ <a href="https://www.thanatkorn.com/">https://www.thanatkorn.com/</a> ภายในวันที่ 5 กรกฎาคม 2566 เวลา 23.59 น.</li>
                    <li>ของรางวัลไม่สามารถโอนให้ท่านอื่น หรือเปลี่ยนแปลงเป็นเงินสดได้</li>
                    <li>ของรางวัลที่ได้รับไม่สามารถเปลี่ยนรุ่น หรือเปลี่ยนสี และไม่สามารถเปลี่ยนเป็นเงินสด หรือของรางวัลอื่นได้ และไม่มีการจ่ายเงินเป็นส่วนประกอบ </li>
                    <li>ผู้ที่ได้รับรางวัลมูลค่าา 1,000 บาทขึ้นไป จะต้องชำระภาษี ณ ที่จ่าย 5% ของมูลค่ารางวัลที่ได้รับ ตามคำสั่งกรมสรรพกร ที่ ทป. 101/25448 จากราคาเต็มของรางวัลด้วยตนเอง ก่อนรับของรางวัลเท่านั้น  หากไม่ได้รับการติดต่อหรือชำระค่าภาษีภายในวันและเวลาที่กำหนดไว้ ถือว่าสละสิทธิ์การรับรางวัล</li>
                    <li>หากไม่สะดวกชำระภาษีรางวัล 5% ตามที่กำหนดไว้ ถือว่าสละสิทธิ์</li>
                    <li>ผู้จัดกิจกรรมจะไม่รับผิดชอบใด ๆ เกี่ยวกับคุณภาพของรางวัล และความสูญหาย หรือเสียหายที่อาจเกิดขึ้นกับ และ/หรือ เนื่องจากของรางวัลไม่ว่าจะด้วยสาเหตุใดรวมถึงแต่ไม่จำกัดเพียง ความสูญหายและเสียหายจากการขนส่งหรือส่งมอบของรางวัล และผู้จัดกิจกรรมขอสงวนสิทธิ์ที่จะไม่อนุญาตให้ผู้โชคดีเปลี่ยนแปลงของรางวัลที่ตนเลือกหลังจากที่ได้ยืนยันการแลกของรางวัลแล้วทุกกรณี</li>
                    <li>ผู้จัดกิจกรรมขอสงวนสิทธิ์ในการยกเลิก เปลี่ยนแปลง ยืดขยาย หรือถอนกิจกรรมได้โดยดุลพินิจของผู้จัดกิจกรรมเพียงผู้เดียว</li>
                    <li>กรณีที่ผู้ร่วมกิจกรรม ที่ยังไม่บรรลุนิติภาวะตามกฏหมาย ผู้จัดกิจกรรมมีสิทธิ์เรียกร้องให้ปกครองของผู้ชนะต้องเป็นผู้เซ็นรับทราบในเอกสารยืนยันการรับรางวัล และหรือร่วมกิจกรรมใด ๆ ได้ตามที่ผู้จัดกิจกรรมกำหนด หากผู้ร่วมกิจกรรม หรือผู้ชนะกิจกรรมไม่สามารถนำเอกสารดังกล่าวมายื่นให้ผู้จัดกิจกรรมดังกล่าวได้ภายในระยะเวลาที่กำหนด ให้ถือว่าผู้ร่วมกิจกรรม หรือผู้ชนะการประกวดดังกล่าวสละสิทธิในการร่วมกิจกรรม และหรือการรับของรางวัลโดยไม่มีเงื่อนไขใด  ๆ ทั้งสิ้น</li>
                        <li>ผู้ร่วมกิจกรรมไม่มีสิทธิ์เรียกร้องค่าตอบแทน ค่าเสียหาย หรือสิ่งใด ๆ จากผู้จัดกิจการรม บริษัท ธนัทกร อินเตอร์เนชั่นแนล จำกัด และหรือ TNKI ไม่ว่าทางแพ่ง หรือทางอาญา </li>
                    <li>ผู้ร่วมกิจกรรมและผู้ชนะ โดยการเข้าร่วมกิจกรรมนี้ ถือว่าได้ให้ความยินยอมให้ผู้จัดกิจกรรมมีสิทธิอย่างเด็ดขาดในการพิมพ์และ/หรือเผยแพร่รายชื่อ รูปถ่าย ของผู้ร่วมกิจกรรม และหรือผู้ชนะการประกวด เพื่อการโฆษณา และประชาสัมพันธ์ธุรกิจทั้งในปัจจุบันและ/หรือในอนาคต โดยไม่ต้องบอกกล่าวใด ๆ ต่อผู้ร่วมกิจกรรม และหรือผู้ชนะการประกวด และผู้ร่วมกิจกรรม และผู้ชนะการประกวดไม่มีสิทธิในการร้องขอกรรมสิทธิ หรือค่าตอบแทนในรูปแบบใด ๆ ก็ตาม</li>
