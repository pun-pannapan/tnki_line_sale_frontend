@section Scripts {
    <script type="text/javascript">
    $(function () {
        var mapping = {
        }
        $(document).ready(function () {
            function ViewModel(data) {
                self.myObject = this;
                ko.mapping.fromJS(data, {}, self.myObject);

                myObject.showTerm = function () {
                    $('#popupTerm').modal('show');
                }

                myObject.isAccept = ko.computed(function () {
                    return self.myObject.custData.custCheckPrivacy();
                }, this, { pure: true });

                myObject.insertPersonalData = function () {
                    if (myObject.custData.custFirstName.isValid() &&
                        myObject.custData.custLastName.isValid() &&
                        myObject.custData.custTel.isValid()) {
                        blockUI();

                        //every person always set to join custCheckTopSpender
                        myObject.custData.custCheckTopSpender = true;
                        insertPersonalData(myObject.custData, resultReg => {
                                var stateReg = localStorage.getItem('TNKILINESALE:OUTWRT:STATE');
                        
                            if (stateReg != undefined && stateReg != null && stateReg != '') {
                                    localStorage.setItem('TNKILINESALE:OUTWRT:TOKEN', resultReg.data.token);
                                insertVisitLog(stateReg, resultState => {
                                        localStorage.removeItem('TNKILINESALE:OUTWRT:STATE');
                                    window.location.href = _app.baseURL + 'Home/LandingPage';
                                });
                            } else {
                                  window.location.href = _app.baseURL + 'Home/LandingPage';
                            }
                        });
                    } else {
                        var msg = "โปรดกรอกข้อมูลให้ครบถ้วน";
                        toastr["error"](msg);
                    }
                }

                myObject.custData.custFirstName.extend({
                    required: {
                        message: "* จำเป็น"
                    }
                });
                myObject.custData.custLastName.extend({
                    required: {
                        message: "* จำเป็น"
                    }
                });
                myObject.custData.custTel.extend({
                    required: {
                        message: "* จำเป็น"
                    },
                    pattern: {
                        params: /\d[0-1,3-9]\d\d\d\d\d\d\d\d/,
                        message: "เบอร์โทรศัพท์มือถือเท่านั้น"
                    },
                    minLength: {
                        params: 10,
                        message: "* ข้อมูลเบอร์โทรศัพท์ต้องครบ 10 หลัก"
                    },
                    maxLength: {
                        params: 10,
                        message: "* ข้อมูลเบอร์โทรศัพท์ต้องครบ 10 หลัก"
                    },
                    number: {
                        message: "* เป็นตัวเลขเท่านั้น"
                    }
                });
                myObject.custData.custFirstName.valueHasMutated();
                myObject.custData.custLastName.valueHasMutated();
                myObject.custData.custTel.valueHasMutated();

             }
            var model = JSON.parse('@Html.Raw(Json.Serialize(Model))');
            ko.applyBindings(new ViewModel(model));
            
            reauthenLiff('home/Register', '', 'Register');
            $('.numeric').numeric();
        });
    });
    </script>
}