@section Scripts {
    <script type="text/javascript">
        function addToCart(productId) {
            fetch('/Home/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ productId: productId })
            })
            .then(response => {
                if (response.ok) {
                     toastr.info("✔️ เพิ่มแล้วในตะกร้า");
                } else {
                    toastr.info("ไม่สามารถเพิ่มสินค้าได้ กรุณาลองอีกครั้ง");
                }
            });
        }

        function buyNow(productId) {
           window.location.href = '/Home/BuyNow/' + productId;
        }

        function productDetail(productId) {
           window.location.href = '/Home/ProductDetail/' + productId;
        }

        $(function () {
            var mapping = {
            }
            $(document).ready(function () {
                function ViewModel(data) {
                    self.myObject = this;
                    ko.mapping.fromJS(data, {}, self.myObject);
                }
                var model = JSON.parse('@Html.Raw(Json.Serialize(Model))');
                ko.applyBindings(new ViewModel(model));

                reauthenLiff('home/Index', '', 'Index');

                $('#mainPage').css({
                    "text-decoration": "underline"
                });
            });
        });
    </script>
}