        .product-card {
            border: 1px solid #eee;
            border-radius: 5px;
            padding: 10px;
            margin-bottom: 20px;
        }

        .product-title {
            font-size: 0.95rem;
            font-weight: bold;
        }

        .product-price {
            color: #007bff;
            font-weight: bold;
        }

        .badge-recommend {
            background-color: #f5f5f5;
            border-radius: 15px;
            padding: 5px 15px;
        }

        .border-top-section {
            border: none;
            border-top: 5px solid #ccc; /* สีเทาอ่อน */
            margin: 1rem 0;
        }

        .background-white {
            background-color:#fff;
        }
    </style>
}


