<script type="text/javascript">
      var _app = {
        "evTypePage": "PAGE",
        "evTypeEvent": "EVENT",
        "baseURL": "@Url.Content("~/")",
        "guidEmpty": "00000000-0000-0000-0000-000000000000",
        "liffID": '@ViewBag.liffID',
        "baseFront": '@ViewBag.baseFront',
        "baseAPI": '@ViewBag.baseAPI'
      };
    function blockUI() {
        $.blockUI({
            css: {
                backgroundColor: 'transparent',
                border: 'none'
            },
            message: '<div class="spinner"></div>',
            baseZ: 1500,
            overlayCSS: {
                backgroundColor: '#FFFFFF',
                opacity: 0.7,
                cursor: 'wait'
            }
        });

    }
</script>